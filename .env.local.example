# Watchily web runtime configuration.
# See docs/application-foundation.md for scope, requiredness, and feature behavior.

# === Supabase (public client; required) ===
NEXT_PUBLIC_SUPABASE_URL=https://jehowbdfqhteznmbyecu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, optional; required only for trusted createAdminClient() flows.
SUPABASE_SECRET_KEY=

# === Application URLs (public; optional) ===
# SITE_URL is used for canonical/SEO URLs; APP_URL is used by server redirects.
NEXT_PUBLIC_SITE_URL=https://watchily.wayool.com
NEXT_PUBLIC_APP_URL=https://watchily.wayool.com

# === Streaming providers ===
# Required server-only primary provider.
WATCHMODE_API_KEY=
# Optional server-only secondary provider. Direct API is preferred.
MOVIEOFTHENIGHT_API_KEY=
# Optional server-only RapidAPI fallback (use this or RAPIDAPI_KEY).
STREAMING_AVAILABILITY_API_KEY=
RAPIDAPI_KEY=
# Optional server-only routing flag. Defaults to 1; set 0 to use Watchmode-only
# for countries outside Watchmode's plan.
AVAILABILITY_SA_FOR_UNSUPPORTED_REGIONS=1

# === PostHog analytics (public client; optional pair) ===
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# === Upstash rate limiting (server-only; optional pair) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Inngest background jobs (server-only; optional pair) ===
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# === Web Push / PWA ===
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional server-only contact address (mailto: or https:); a default exists.
VAPID_SUBJECT=mailto:notificaciones@watchily.app

# === Sentry (server/build; optional) ===
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=watchily-ho

# === Vercel / indexing (normally managed by the platform; optional locally) ===
VERCEL_URL=
VERCEL_ENV=
VERCEL_GIT_COMMIT_REF=
OMNI_ALLOW_PREVIEW_INDEX=false

# === TV UI mode (server; optional) ===
# Default is react (Library/Search shell). Set standalone to force legacy HTML *-standalone routes.
# Override per request with ?tv_ui=react|standalone (also use ?device=tv in desktop browsers).
# TV_UI_MODE=react

# NODE_ENV is managed by Next.js (development, test, or production).
# NODE_ENV=
